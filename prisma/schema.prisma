// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// Auth.js Required Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials login
  accounts      Account[]
  sessions      Session[]

  // Service-specific fields
  userType      String?   // JSON array: ["vendor"], ["owner"], or ["vendor", "owner"]
  isAdmin       Boolean   @default(false)
  notificationSettings String? // JSON object for notification preferences
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Stripe
  stripeCustomerId  String?  @unique
  subscription      Subscription?

  // Gamification
  totalPoints   Int       @default(0)

  // Relations
  profile       Profile?
  stores        Store[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  favorites       Favorite[]
  storeFavorites  StoreFavorite[]
  organizerFollows OrganizerFollow[]
  reviewsGiven    Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  notifications Notification[]
  checkIns          CheckIn[]
  storeReviews      StoreReview[]
  pointTransactions PointTransaction[]
  blogPosts         BlogPost[]
  claimRequests     StoreClaimRequest[]

  // イベント出店募集
  organizerProfile     OrganizerProfile?
  eventAppMessages     EventApplicationMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Service-specific Models
// ============================================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  description String?
  category    String?
  area        String?
  tags        String?  // JSON array stored as string
  website     String?
  instagram   String?
  twitter     String?
  isVerified  Boolean  @default(false)

  images      ProfileImage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfileImage {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

model Store {
  id          String   @id @default(cuid())
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  category    String?
  area        String?   // 主な出店エリア
  tags        String?   // JSON array stored as string

  // 新セクション
  ownerIntro      String?  // オーナー・スタッフ紹介
  recommendedItems String? // おすすめ商品
  commitment      String?  // こだわりポイント
  calendarImageUrl String? // 出店カレンダー画像URL
  availableAreas  String?  // 出店可能な県（JSON配列）
  newsText        String?  // お知らせテキスト
  newsImageUrl    String?  // お知らせ画像URL
  messageToOwners String?  // スペースオーナーへ一言
  motto           String?  // 出店時に大切にしていること

  // ビジネス情報
  website     String?
  instagram   String?
  twitter     String?

  // キッチンカー車両サイズ（cm）
  vehicleLength Int?
  vehicleWidth  Int?
  vehicleHeight Int?

  // QRコード用トークン
  qrToken     String?  @unique

  images      StoreImage[]

  isActive    Boolean  @default(false)
  draftData   String?  // 下書きデータ（JSON）

  // 管理者作成 → 店舗営業者へのクレーム招待フロー
  claimEmail   String?   // 招待先の連絡先メモ（任意）
  claimStatus  String    @default("none") // "none" | "invited" | "claimed"
  invitedAt    DateTime? // 招待リンク発行日時
  claimedAt    DateTime? // 営業者が承認した日時

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Gamification relations
  checkIns       CheckIn[]
  storeReviews   StoreReview[]
  storeFavorites StoreFavorite[]

  // 引き継ぎ申請
  claimRequests  StoreClaimRequest[]

  // 出店申込パック
  applicationProfile   StoreApplicationProfile?
  applicationDocuments ApplicationDocument[]
  applicationMenuItems ApplicationMenuItem[]
  shareLinks           ShareLink[]
  spaceLeads           SpaceLead[]

  // イベント出店募集
  eventApplications    EventApplication[]
}

// 店舗の引き継ぎ（クレーム）申請
// 自己登録時にダブり検知した際、既存店舗を「自分の店」として引き継ぐ申請。
// 運営が承認して初めて ownerId が紐付く（本人確認＝人の承認）。
model StoreClaimRequest {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  message    String?  // 申請者の補足（証拠URL・関係性の説明など）
  status     String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?  // 対応した管理者のUserId

  @@index([storeId])
  @@index([userId])
  @@index([status])
}

model StoreImage {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url     String
  order   Int     @default(0)
  isDraft Boolean @default(false)
}

model Space {
  id          String   @id @default(cuid())
  ownerId     String

  name        String
  description String?
  location    String
  address     String?
  capacity    String?
  price       String?
  tags        String?  // JSON array stored as string

  facilities  String?  // JSON array stored as string
  openingHours String?
  closedDays  String?

  images      SpaceImage[]
  favorites   Favorite[]
  reviews     Review[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SpaceImage {
  id      String @id @default(cuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
}

model StoreFavorite {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  content    String?

  authorId   String
  targetId   String   // User who receives the review
  spaceId    String?  // Optional: related space

  author     User     @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  space      Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Booking {
  id          String   @id @default(cuid())
  vendorId    String
  spaceId     String

  date        DateTime
  status      String   @default("pending") // pending, confirmed, cancelled, completed
  message     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VerificationRequest {
  id          String   @id @default(cuid())
  userId      String   @unique

  documentType String  // "business_license", "id_card", etc.
  documentUrl  String?
  status       String  @default("pending") // pending, approved, rejected
  note         String? // Admin notes or rejection reason

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "message", "booking", "review"
  title     String
  body      String
  link      String?  // リンク先URL
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("general") // "general", "account", "matching", "payment", "other"
  order       Int      @default(0)
  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// Pre-registration for Coming Soon LP
// ============================================

model PreRegistration {
  id          String   @id @default(cuid())
  email       String   @unique
  userType    String   // "vendor" (出店者) or "owner" (スペースオーナー)
  createdAt   DateTime @default(now())
}

// ============================================
// Stripe Subscription
// ============================================

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String   @unique
  stripePriceId          String
  stripeCurrentPeriodEnd DateTime
  status                 String   @default("active") // active, canceled, past_due, unpaid
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ============================================
// Gamification Models
// ============================================

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([userId, storeId])
  @@index([storeId])
}

model StoreReview {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([userId, storeId])
  @@index([storeId])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  type      String   // "checkin" | "review"
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ============================================
// Operator Blog (運営ブログ)
// ============================================

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique // URL用の識別子
  title       String
  excerpt     String?   // 概要文（一覧・OGP用）
  content     String    @default("") // 本文 HTML（Tiptap出力）
  coverImage  String?   // カバー画像URL
  category    String?   // カテゴリ
  tags        String?   // カンマ区切りタグ
  isPublished Boolean   @default(false)
  publishedAt DateTime? // 公開日時
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isPublished, publishedAt])
}

// ============================================
// 出店申込パック（共有URL機能）
// 出店者が一度登録すれば、主催者向けの公開URLと申込書PDFをワンクリックで出せる。
// 出店者の実体は Store（1ユーザーが複数店舗を持てる）なので、すべて storeId 単位で持つ。
// 屋号 / 業種 / 車両サイズ(cm) / 出店可能エリア / SNS などは Store 側の既存カラムを使い、
// ここには「申込書のために追加で必要な項目」だけを置く。
// ============================================

model StoreApplicationProfile {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // 基本情報（既存 Store/User に無いものだけ）
  phone        String? // 申込用の連絡先電話番号
  contactEmail String? // 申込用の連絡先メール（未設定なら User.email を使う）
  openedOn     String? // 開業年月 "2020-04"
  appeal       String? // 自己PR（2000字）

  // 車両（全長・全幅・全高は Store.vehicleLength/Width/Height (cm) を使う）
  vehicleType       String? // "kei_truck" | "kei_van" | "1t" | "1.5t" | "other"
  vehicleWeightKg   Int?
  plateNumber       String?
  plateNumberPublic Boolean @default(false) // 既定は非公開

  // 設備・インフラ要件（主催者が可否判断する箇所）
  powerWatt        Int?
  hasGenerator     Boolean @default(false)
  generatorModel   String?
  generatorNoiseDb Int?
  usesFire         Boolean @default(false)
  fireType         String? // "lpg" | "cassette" | "electric_only"
  // 主催者が消防署に出す書類で台数を書くので、有無だけでは足りない（2026-08-27 MTG）。
  // ここは平常時の台数。イベントごとの実数は応募時に上書きしてスナップショットへ残す。
  fireApplianceCount Int?
  waterTankLiter   Int?
  minSpaceWidthM   Float? // 間口(m)
  minSpaceDepthM   Float? // 奥行(m)

  // 営業条件（出店可能エリアは Store.availableAreas を使う）
  maxServingsPerHour Int?
  secondsPerServing  Int?
  availableDays      String? // JSON配列 ["mon","tue",...]
  hasPrepKitchen     Boolean @default(false) // 仕込み場所の有無
  prepKitchenNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 申込書類（営業許可証・食品衛生責任者証・PL保険証券・車検証など）
// ファイル実体は R2 の非公開キーで保持し、URL はDBにも API レスポンスにも出さない。
// 配信は必ず認証付き / トークン付きのストリーミングAPI経由。
model ApplicationDocument {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type      String // "business_license" | "food_hygiene" | "pl_insurance" | "vehicle_inspection" | "other"
  label     String?
  fileKey   String // R2 オブジェクトキー（公開URLではない）
  mimeType  String
  fileSize  Int
  expiresOn DateTime? // 書類の有効期限

  // "public"（実体を公開） | "meta_only"（メタ情報のみ・実体URLは一切返さない） | "private"（非表示）
  visibility String @default("meta_only")
  order      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // やり取りの中でこの書類を開示した相手
  disclosures EventApplicationDocument[]

  @@index([storeId])
}

// 申込用メニュー（公開前提。写真は公開R2でよい）
model ApplicationMenuItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  price       Int?
  description String?
  imageUrl    String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// 共有リンク（出店者が主催者ごとに発行する）
// ラベルを付けられることで送付先の管理台帳になり、同時にリード獲得のアトリビューションが取れる。
model ShareLink {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  token        String    @unique // 推測不能なランダム文字列
  label        String? // 例: "〇〇マルシェ様"
  expiresAt    DateTime? // 任意。既定は無期限
  passwordHash String? // 任意。既定はなし
  revokedAt    DateTime?

  viewCount    Int       @default(0) // 重複排除後の閲覧数
  printCount   Int       @default(0) // 印刷用ページの表示回数
  lastViewedAt DateTime?

  createdAt DateTime @default(now())

  views ShareLinkView[]
  leads SpaceLead[]

  @@index([storeId])
}

// 閲覧ログ。同一IP・同一UAからの5分以内の再訪は記録しない（水増し防止）
model ShareLinkView {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  kind    String  @default("page") // "page" | "print"
  ipHash  String // ソルト付きハッシュ。生IPは保存しない
  uaHash  String
  referer String?

  createdAt DateTime @default(now())

  @@index([shareLinkId, createdAt])
}

// スペースリード（オーナー獲得の入口）。公開ページ最下部のCTAから送信される。
model SpaceLead {
  id          String     @id @default(cuid())
  shareLinkId String? // どのリンク経由か
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  storeId     String? // 誰の紹介か
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)

  spaceName    String // スペース名または所在地
  area         String?
  contactName  String
  contactEmail String?
  contactPhone String?
  note         String?

  status String @default("new") // "new" | "contacted" | "qualified" | "registered" | "rejected"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([shareLinkId])
  @@index([storeId])
}

// レート制限カウンタ（固定ウィンドウ）
// Vercel はインスタンスが分散するためメモリ内カウンタでは効かない。Turso 上で数える。
model RateLimitCounter {
  id        String   @id // "<bucket>:<key>:<windowStart>"
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================
// イベント出店募集
// 主催者が募集を出し、出店者が応募する。応募（およびスカウト）は1件ごとに
// やり取りの場を持ち、その中で出店者が書類を開示し、主催者が確認して成立を決める。
// 書類そのものは出店申込パックの ApplicationDocument を使い回すので、
// 出店者が再アップロードすることはない。
// ============================================

// 主催者プロフィール。運営が承認するまで募集を公開できない。
// 架空のイベントで出店者を集める事故を防ぐため、初期は人が見る。
model OrganizerProfile {
  id String @id @default(cuid())

  // 1アカウント = 1主催者名義。同じ人が複数の団体で主催する場合は
  // アカウントを分けてもらう。名義を複数持てるようにすると、募集の作成時に
  // 名義を選ばせることになり、画面が一段複雑になるため（2026-08-18 決定）。
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgName     String // 団体名・主催者名
  contactName String?
  phone       String?
  website     String?
  intro       String? // 主催実績など

  status     String    @default("pending") // "pending" | "approved" | "rejected"
  note       String? // 運営メモ・却下理由
  reviewedAt DateTime?
  reviewedBy String? // 対応した管理者のUserId

  events    Event[]
  followers OrganizerFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// 出店者が主催者をフォローする。次の募集が公開されたときに知らせるためのもの。
// 募集は期間が短く、見逃すと終わりなので、主催者を起点に取りこぼしを防ぐ
// （2026-08-27 先方フィードバック）。誰がフォローしているかは主催者に見える。
model OrganizerFollow {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizerId])
  @@index([organizerId])
}

model Event {
  id          String           @id @default(cuid())
  organizerId String
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // 会場
  venueName String
  address   String?
  area      String // 都道府県

  // 開催日時
  startAt DateTime
  endAt   DateTime

  // 募集期間（開催の2ヶ月前から募集を始めるのが一般的）
  applicationOpenAt  DateTime?
  applicationCloseAt DateTime?
  slots              Int? // 募集枠数

  // 出展料は必須。「応相談」は許さず、出店者が金額で絞り込めることを優先する（無料は0円）。
  // 区画ごとの実額は EventFeeTier に持ち、この2列はそこから算出した最安値・最高値。
  // 一覧カード・検索の絞り込み・OGP は必ずこの2列を見る（区画の行を読ませない）。
  // 単一料金なら exhibitFeeMax は null。
  exhibitFee    Int
  exhibitFeeMax Int?
  feeNote       String? // 「+売上の10%」など、募集全体にかかる補足

  // 出店条件（出店者が応募前に知りたい項目）
  spaceWidthM       Float?
  spaceDepthM       Float?
  powerAvailable    Boolean @default(false)
  powerWatt         Int? // 1区画あたり提供できる電源
  waterAvailable    Boolean @default(false)
  fireAllowed       Boolean @default(false)
  categories        String? // JSON配列: 募集する業種
  requiredDocuments String? // JSON配列: 成立時に提出を求める書類の種類
  expectedVisitors  Int?
  note              String?

  status      String    @default("draft") // "draft" | "published" | "closed" | "cancelled"
  publishedAt DateTime?
  // フォロワーへ新着を知らせた時刻。下書きに戻して再公開しても二重に送らないための印。
  followersNotifiedAt DateTime?

  images       EventImage[]
  feeTiers     EventFeeTier[]
  applications EventApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startAt])
  @@index([area])
  @@index([organizerId])
}

// 区画・エリアごとの出展料。「Aエリア 8,000円 / 角地 15,000円」のように実額を
// 並べて出せるようにする。概算より細かく書かれている方が出店者は判断しやすい
// （2026-08-27 MTG）。行は何本でも持てる。
model EventFeeTier {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label  String? // 「Aエリア 3m×3m」「角地」。単一料金なら未設定でよい
  fee    Int
  note   String? // この区画だけにかかる補足
  slots  Int? // この区画の枠数
  widthM Float?
  depthM Float?
  order  Int     @default(0)

  @@index([eventId])
}

model EventImage {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)

  @@index([eventId])
}

// 応募とスカウトの両方がここに入る。1店舗1イベントにつき1スレッド。
model EventApplication {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  kind   String @default("application") // "application"（出店者から） | "scout"（主催者から）
  status String @default("open") // "open" | "confirmed" | "rejected" | "withdrawn"

  // 応募時点の車両・設備・営業条件。あとで出店者が申込情報を書き換えても、
  // 主催者が見て判断した内容が残るようにする。
  snapshot String?
  message  String? // 最初のひとこと

  // 主催者から「書類を見せてほしい」と依頼した時刻
  documentRequestedAt DateTime?

  confirmedAt DateTime?
  closedAt    DateTime?

  lastMessageAt      DateTime?
  vendorLastReadAt   DateTime?
  organizerLastReadAt DateTime?

  messages    EventApplicationMessage[]
  disclosures EventApplicationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, storeId])
  @@index([eventId, status])
  @@index([storeId])
}

model EventApplicationMessage {
  id            String           @id @default(cuid())
  applicationId String
  application   EventApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  senderId String? // system の場合は null
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  // "text" は人が書いたもの。"system" は開示・成立などの経過記録。
  kind String @default("text")
  body String

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
}

// やり取りの中で開示された書類。開示は相手ごと・書類ごとで、いつでも取り消せる。
// 見送りになった応募では自動的に失効させる。
model EventApplicationDocument {
  id            String           @id @default(cuid())
  applicationId String
  application   EventApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentId String
  document   ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  disclosedAt DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([applicationId, documentId])
  @@index([applicationId])
}
